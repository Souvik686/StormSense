# Environment configuration for SevereWeatherNet API
# Copy this file to .env and fill in values.
# .env is in .gitignore and will NOT be committed.

# Optional: API authentication key (leave empty for open access during dev)
API_KEY=

# Path to trained model checkpoint (after running train_colab.py)
CHECKPOINT_PATH=outputs/checkpoints/best.pt

# Path to configuration YAML (defaults to configs/default.yaml if not set)
CONFIG_PATH=

# API server settings
HOST=0.0.0.0
PORT=8000
RELOAD=0

