# StormSense environment configuration.
# Copy this file to .env in the project root and fill in real values.
# .env is gitignored and must never be committed.

# --- Required ---------------------------------------------------------
# OpenWeatherMap current-conditions API key. The backend refuses to start
# without this (backend/config.py raises RuntimeError if it's missing).
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Google Maps JavaScript API key, used by the browser to render the map.
# This is a BROWSER key by design (it is served to the page), so it is not
# secret in the usual sense -- protect it in Google Cloud Console with
# HTTP referrer restrictions (your production domain, plus
# http://localhost:8000/* and http://127.0.0.1:8000/* for local dev) and
# restrict it to the Maps JavaScript API only.
# Either spelling is accepted by the backend.
GOOGLE_MAPS_API_KEY=

# --- Optional -----------------------------------------------------------
# Comma-separated list of additional Google Maps keys for automatic
# failover if the primary key hits its daily quota. Leave empty to use
# only GOOGLE_MAPS_API_KEY above.
GOOGLE_MAPS_API_KEYS=

# Comma-separated list of allowed frontend origins for CORS, only needed
# when running the frontend and backend on different ports/hosts (split
# mode via run_frontend.py + run_backend.py). Not needed for the default
# merged mode (run_server.py serves both from one origin).
STORMSENSE_CORS_ORIGINS=

# Host/port the backend binds to.
HOST=127.0.0.1
PORT=8000
