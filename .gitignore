# ============================================================
# STORMSENSE .gitignore
# ============================================================

# --- Secrets -------------------------------------------------
.env
**/.env
*.env
*.env.*
!.env.example
backend/.env

# --- Local diagnostics / ad-hoc scripts ---------------------------
# A local investigation folder like this previously held a credential
# backup that got committed by accident (see README security notes).
# Ignored outright so that mistake cannot repeat.
diagnostics/

# --- Python ----------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/

# --- Virtual environments --------------------------------------
venv/
.venv/
env/

# --- Local/generated artifacts -----------------------------------
*.log
*.tmp
*.bak
*.swp

# --- OS / editor junk --------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Raw source datasets (build-time only) ------------------------
# Rebuilds processed/cache/era5_memmap/ via `python -m src.data.preprocess`.
# Not read at runtime; the cache the app actually reads is tracked below.
Data/ERA5/
Data/DEM/

# --- INSAT satellite archive (required at runtime, not committed) -------
# Read directly by src/inference/insat_archive.py for the historical case
# study's satellite panel. ~12GB of HDF5 files -- too large to commit even
# via Git LFS. Must be present on disk at Data/INSAT/ after cloning; see
# README for how to obtain it. The app degrades gracefully (reports
# "unavailable", never fabricates data) if this directory is absent.
Data/INSAT/

# Raw boundary sources (build-time only, via scripts/build_wb_boundaries.py).
# The processed `_full` boundary files the app reads ARE tracked in git.
Data/BOUNDARIES/IND_ADM2.zip
Data/BOUNDARIES/north_24_parganas.geojson
Data/BOUNDARIES/west_bengal.geojson
Data/BOUNDARIES/west_bengal_districts.geojson

# Runtime-generated boundary mask cache (auto-created on first request by
# get_or_create_wb_mask() if missing -- never needs to be committed).
Data/BOUNDARIES/wb_mask_full_*.npy

# --- Compressed/raw grid formats (not runtime-read directly) ------
*.grib2
*.idx
*.nc

# --- Temporary cache (Live Mode) ---
processed/cache/gfs/

# --- Obsolete/redundant checkpoints ---
Data/outputs/checkpoints/best.pt
Data/outputs/checkpoints/v2_best.pt
Data/outputs/checkpoints/v2_last.pt
